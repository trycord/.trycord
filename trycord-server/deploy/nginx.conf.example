# Trycord nginx reverse-proxy example (server mode: SERVER_HOST_TYPE=nginx)
#
# Topology:  Cloudflare / HTTPS  ->  nginx :443  ->  Trycord Express 127.0.0.1:9971
#
# - Serves the static web client directly from the repository.
# - Proxies /api/* and /ws to Trycord Express with WebSocket upgrade support.
# - Preserves Host/X-Real-IP/X-Forwarded-For/X-Forwarded-Proto so Express can
#   detect the real client IP and scheme (pair with TRUST_PROXY=1 server-side).
# - Copies the Cloudflare client IP when present.
# - Never serves the nginx default page: this server block is the site.
#
# Adjust trycord.dev to the real public origin, and the client root to the
# absolute path of the deployed trycord-client directory.

server {
    listen 80;
    listen [::]:80;
    server_name trycord.dev;

    # Cloudflare / TLS terminates here (or at Cloudflare); force HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name trycord.dev;

    # TLS certificates (e.g. Certbot / Let's Encrypt, or Cloudflare origin certs).
    # ssl_certificate     /etc/letsencrypt/live/trycord.dev/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/trycord.dev/privkey.pem;

    # Uploads: attachments are read only through the authenticated API route,
    # but the multipart headers themselves can be large. Set to what your
    # upload limits allow (server uploads.js has its own cap as well).
    client_max_body_size 25m;

    # Real client address + scheme, fed to Express with TRUST_PROXY=1.
    real_ip_header X-Forwarded-For;
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;

    location /api/ {
        proxy_pass http://127.0.0.1:9971;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Cloudflare deployments: pass the CF client IP when present.
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # WebSocket gateway. Authentication stays in Trycord: nginx only upgrades.
    location /ws {
        proxy_pass http://127.0.0.1:9971;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Static web client. Entry points are served uncached; versioned assets
    # are ETag-revalidated so new deploys land without stale-content bugs.
    root /srv/trycord/trycord-client;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(css|js|svg|png|jpg|jpeg|gif|webp|woff2?)$ {
        expires 1h;
        add_header Cache-Control "public, no-cache";
    }

    location = /index.html {
        add_header Cache-Control "no-store";
    }
    location = /config.js {
        add_header Cache-Control "no-store";
    }

    # Strong defaults; Express also sets its own security headers.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
}