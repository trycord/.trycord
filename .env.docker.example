# Trycord - Docker configuration.
#
#   cp .env.docker.example .env
#   edit JWT_SECRET (required) and anything else you care about
#   docker compose up -d
#
# docker-compose.yml overrides HOST/PORT/DB_CLIENT/DB_FILE/SERVER_HOST_TYPE
# so you do not need to repeat them here.

# Port on the host. The container always listens on 9971.
TRYCORD_PORT=9971

# REQUIRED. The server refuses to start without it. Every instance needs a
# different value, and changing it later invalidates every issued session
# and password-reset token.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- instance identity ------------------------------------------------------
TRYCORD_INSTANCE_ID=my-instance
TRYCORD_NAME=My Trycord
# Public address of THIS instance (informational, used in some links).
TRYCORD_PUBLIC_URL=
# Public address of the web client, used to build links inside emails
# (verification, password reset) as ${CLIENT_URL}#/verify-email/<token>.
# Leave unset for self-hosting: the server falls back to the address it is
# actually served from.
#CLIENT_URL=

# --- database ---------------------------------------------------------------
# SQLite by default: a single file on the trycord-data volume. Suitable for
# small and mid-size instances. Switch to MySQL by uncommenting the block at
# the bottom of this file.
DB_CLIENT=sqlite
#DB_CLIENT=mysql
#DB_HOST=your-mysql-host
#DB_PORT=3306
#DB_NAME=trycord
#DB_USER=trycord
#DB_PASSWORD=
#DB_SSL=false
#DB_POOL=10

# --- mail -------------------------------------------------------------------
# MAIL_MODE=log writes messages to the container log and sends nothing.
# This is the safe default: with it, email verification is not enforceable
# and the app will not ask anyone to verify an address.
MAIL_MODE=log
# For real delivery, set smtp and fill in the relay:
#MAIL_MODE=smtp
#MAIL_FROM=Trycord <no-reply@example.com>
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_SECURE=false

# --- admins -----------------------------------------------------------------
# Comma-separated usernames promoted to platform admin (Trust & Safety) at
# boot. The account must already exist: create it in the app first, then set
# this and restart. Idempotent, so it is safe to leave in place.
#ADMIN_USERNAMES=alice

# --- security ---------------------------------------------------------------
# Comma-separated origins allowed to call the API. Only needed when the web
# client is hosted somewhere other than this server. If you serve the bundled
# client (the default), you still need the desktop app's origin below, or the
# packaged desktop client cannot read API responses.
#
#   https://trycord.dev      exact origin
#   http://*.trycord.dev     any single subdomain of that host
#   trycord://app            the desktop app
#
# Add trycord://app whenever the desktop client should reach this instance.
CLIENT_ORIGIN=trycord://app
# Set to 1 only when a reverse proxy on this host fronts the container and
# you are running SERVER_HOST_TYPE=nginx.
#TRUST_PROXY=1
#WS_MAX_PAYLOAD=204800

# --- optional status monitor ------------------------------------------------
# A second, independent container that checks this instance on a schedule and
# serves a report on its own port. It is off until you start it with the
# override file:
#   docker compose -f docker-compose.yml -f docker-compose.monitor.yml up -d
# See docs/status-monitor.md for every setting.
#
# Host port for the monitor. The container always listens on 9972.
STATUS_MONITOR_PORT=9972
# The address a browser uses to reach the monitor. Set it to make the public
# /status page read the monitor's live report instead of probing from the
# browser. Leave it unset and the page probes from the browser as before.
#STATUS_MONITOR_PUBLIC_URL=http://localhost:9972
# How often the monitor runs its checks, and the base the target URLs resolve
# against. The compose override points the base at the API container already.
#STATUS_MONITOR_INTERVAL_MS=30000
