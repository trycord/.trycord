{
  "name": "trycord-desktop",
  "version": "6.0.2",
  "private": true,
  "description": "The Trycord desktop application: the same web client in a window of its own.",
  "license": "SEE LICENSE IN ../LICENSE",
  "author": "Trycord",
  "homepage": "https://trycord.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trycord/.trycord.git",
    "directory": "trycord-desktop"
  },
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/stage-client.mjs && electron .",
    "stage": "node scripts/stage-client.mjs",
    "build:win": "node scripts/stage-client.mjs && electron-builder --win --x64 --publish never",
    "build:linux": "node scripts/stage-client.mjs && electron-builder --linux --x64 --publish never",
    "build:mac": "node scripts/stage-client.mjs && electron-builder --mac --publish never",
    "validate:release": "node scripts/validate-release.mjs",
    "release": "electron-builder --publish always",
    "check": "node scripts/check-desktop.mjs"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.0"
  }
}
