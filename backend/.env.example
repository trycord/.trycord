# Trycord server configuration. Copy to .env and fill in.
# There are no implicit defaults for JWT_SECRET or the database:
# the server refuses to start without them.
#
# --- instance ---
# Hosting topology. Values:
#   express — Express is the public server (development, simple self-hosting,
#             direct-port deployments). HOST default 0.0.0.0.
#   nginx   — nginx (optional Cloudflare in front) is the public reverse
#             proxy; Express binds loopback by default (HOST default
#             127.0.0.1) and does not need a public port. Set SERVER_HOST_TYPE
#             to exactly one of these; anything else fails at startup.
SERVER_HOST_TYPE=express
# Bind address override. If unset, the mode decides: express -> 0.0.0.0,
# nginx -> 127.0.0.1 (backend stays private behind the reverse proxy).
# Set this only to override the per-mode default.
#HOST=0.0.0.0
PORT=9971
# Required: each instance needs its own secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
TRYCORD_INSTANCE_ID=my-instance
TRYCORD_NAME=My Trycord
# Public base URL of this instance (optional, informational).
TRYCORD_PUBLIC_URL=
# Optional global Trycord service. Empty = fully independent instance.
GLOBAL_TRYCORD_URL=
# Set to 1 ONLY when a reverse proxy on the same host (nginx) fronts this
# server. In nginx mode (SERVER_HOST_TYPE=nginx) the server warns at boot if
# this is unset — set it when the proxy is present. trust proxy is pinned to
# loopback, so X-Forwarded-* cannot be spoofed by remote clients; nginx itself
# must copy CF-Connecting-IP for Cloudflare deployments. Unset = direct
# exposure (default).
#TRUST_PROXY=1
# Comma-separated usernames promoted to platform admin (Trust & Safety) at
# boot. Idempotent: safe to keep in .env permanently. Any name that does not
# exist yet is warned about and skipped — create the account first, then
# restart (or re-run) to promote it.
#ADMIN_USERNAMES=alice,bob
# Comma-separated origins allowed to call the API.
# Empty = restricted dev profile (same-origin + localhost only).
# Split deployment (static frontend + remote backend) REQUIRES the frontend
# origin(s) here, otherwise browsers block API calls via CORS.
#
# Three kinds of entry are accepted:
#
#   https://trycord.dev          an exact origin
#   http://*.trycord.dev         any SINGLE subdomain of that host
#                                (a.b.trycord.dev does not match; scheme and
#                                 port must be identical)
#   trycord://app                the desktop app
#
# Always include trycord://app if the desktop client should reach this
# instance. That is the renderer's own origin: the packaged app loads from a
# custom application scheme rather than file://, precisely because a file://
# document has an opaque origin and its API responses get discarded. It is
# deliberately NOT a wildcard for every backend - the app's identity is fixed
# while the backend it talks to is whatever the user configures, so one
# desktop install can reach any number of instances, each listing this origin.
#
# Official frontend + self-hosted subdomains + desktop:
CLIENT_ORIGIN=https://trycord.dev,http://*.trycord.dev,trycord://app
# Optional: extra origins the client may reach at runtime, appended to the
# Content-Security-Policy connect-src/img-src. Add e.g. other Trycord
# instances your users point their client at. ws:// and wss:// are allowed
# by default so the cross-instance feature keeps working.
# (The served client's backend.json pin and a validated ?api= parameter are
# picked up automatically — this knob is only needed for backends the
# server cannot otherwise know about.)
#CSP_CONNECT_ORIGINS=https://chat.example.com
# WebSocket incoming-frame cap in bytes (default 204800). Internally pings
# and heartbeats are unaffected.
#WS_MAX_PAYLOAD=204800
#
# --- public URL (used for absolute links, e.g. password-reset emails) ---
# Explicit configuration only — never derived from request headers.
# Examples: https://trycord.dev (official) or https://chat.example.com
PUBLIC_URL=
# --- client URL (email links: verification, password reset) ---
# Base of the Trycord CLIENT APP, not the API. Email links are built as
# ${CLIENT_URL}#/verify-email/<token> with a literal # fragment.
# Production example: https://trycord.dev/frontend/index.html
# If unset, PUBLIC_URL/TRYCORD_PUBLIC_URL is used, then localhost:9971
# (correct for self-hosted setups where the server root serves the app).
#CLIENT_URL=
#
# --- mail (password reset + email verification) ---
# Three modes, and nothing else. smtp delivers through a relay, api posts JSON
# to an HTTPS endpoint, disabled sends nothing.
#
# disabled is the default and the safe one for development: an instance that
# never configured mail must not believe it is sending any. The previous log
# mode wrote password reset links into the server log in cleartext, so it is
# gone. With mail disabled, recovery flows refuse rather than pretending.
#MAIL_MODE=disabled
#MAIL_FROM=Trycord <no-reply@example.com>
#
# smtp mode. 465 implies TLS, 587 implies STARTTLS.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_SECURE=false
#SMTP_REJECT_UNAUTHORIZED=true
#
# api mode. The endpoint must be https unless it points at localhost, because
# the credential travels in a header. Which vendor this reaches is the
# dashboard's business: the admin names where each part of the message goes in
# the JSON body, so no vendor is named here.
#MAIL_API_ENDPOINT=
#MAIL_API_KEY=
#MAIL_API_AUTH_HEADER=Authorization
#MAIL_API_AUTH_PREFIX=Bearer
#MAIL_API_FROM_FIELD=from
#MAIL_API_TO_FIELD=to
#MAIL_API_SUBJECT_FIELD=subject
#MAIL_API_TEXT_FIELD=text
#MAIL_API_HTML_FIELD=html
#
# Password-reset links live this many minutes (single use either way).
#RESET_TOKEN_TTL_MIN=60
#
# --- database: pick ONE profile ---
# Local development (SQLite file you choose — nothing is created implicitly):
DB_CLIENT=sqlite
DB_FILE=./dev.db
# Production (your own MySQL — never the official credentials):
#DB_CLIENT=mysql
#DB_HOST=localhost
#DB_PORT=3306
#DB_NAME=trycord
#DB_USER=trycord
#DB_PASSWORD=
#DB_SSL=false
#DB_POOL=10
#
# A DB_HOST that is not loopback is refused unless this is exactly "true". A
# remote host is assumed to be production, so a local script or a CI job that
# inherits a copied .env cannot quietly write to a live database. Set it on the
# deployment only.
#
# This exists because the alternative happened: a .env carrying DB_CLIENT twice
# (sqlite, then mysql) resolves to the mysql block, so work intended for a local
# SQLite file ran against production and wrote test data into it.
#ALLOW_REMOTE_DB=true
#
# --- storage ---
# Where uploaded files live. Defaults to ./uploads next to the server package.
# In Docker this is already set to the volume mount, /app/uploads — change it
# only if you move the volume. Everything else about storage is fixed: files
# are keyed by a generated id, never by an uploaded filename.
#UPLOAD_DIR=./uploads

# Storage backend. `local` is the default and needs nothing else. Set to `s3`
# for any S3-compatible endpoint: Amazon S3, Cloudflare R2, MinIO, Backblaze.
# Nothing Cloudflare-specific is required anywhere.
#STORAGE_DRIVER=local
#S3_ENDPOINT=https://s3.amazonaws.com
#S3_REGION=us-east-1
#S3_BUCKET=
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
# Path-style addressing (/bucket/key) is the default because R2 and MinIO need
# it. Only switch to virtual-host style for a DNS-safe bucket on Amazon S3.
#S3_FORCE_PATH_STYLE=true
#
# The bucket must stay private. Trycord serves every file through an
# authenticated route; a public bucket would bypass that entirely.
#
# Before switching a live instance to s3, run the migration tool in --dry-run
# against the target bucket. The signature implementation is unit tested but
# has not been exercised against a live endpoint in CI.
#
# --- tuning (rarely needed) ---
# bcrypt work factor for new password hashes. Cost is stored inside each hash,
# so raising this does not invalidate existing passwords. Raise on fast
# hardware, lower on slow or shared CPUs. 10-15, default 12.
#BCRYPT_COST=12
# Raise every per-endpoint rate limit to one value. Leave unset in normal
# operation: each endpoint then keeps its own tuned limit. Set it only for the
# E2E suite (npm test sets it for you) or when several people share one egress
# address on a private network.
#RATE_LIMIT_MAX=
#
# --- previously undocumented --------------------------------------------
# Read by src/ but missing from this file. Defaults are transcribed from the
# source, not guessed.
#
# Per-account total upload quota in megabytes. A single request is bounded
# separately by the request size limit and a per-route rate limit; this bounds
# the total. Default 512.
#STORAGE_QUOTA_MB=512
#
# Overrides the API origin advertised to the client (runtime-config.js) and
# added to the CSP allowlist. Use it when the API is reachable at an address
# that differs from the public URL. Falls back to TRYCORD_PUBLIC_URL.
#TRYCORD_API_URL=
#
# The primary API and the one the client falls back to when the primary cannot
# be reached. Both are added to the CSP connect-src allowlist, because a failover
# that the policy then refuses would surface as a blank page rather than as a
# switch. The backup is only consulted by a client that ships it in
# backend.json: a self-hoster's own instance is never quietly repointed.
#API_URL=https://api.trycord.dev
#API_BACKUP_URL=https://trycord-api.wispbyte.app
#
# Mounts /api/test, hooks that bypass email verification for automated suites.
# Off unless this is exactly "true", so the paths 404 on every normal boot.
# Never set it on a public instance: those endpoints can verify arbitrary
# addresses.
#ALLOW_TEST_HOOKS=

# ---- serving the web client ---------------------------------------------
# This server serves the web client itself when it can find it. It looks, in
# order, at TRYCORD_CLIENT_DIR, then next to the repository layout this file
# ships with (../../frontend, ../client, ../../trycord-desktop/client),
# then a built tree copied alongside the server (../dist/app).
#
# You only need this when your layout is none of those: a single directory, an
# image that copies the client somewhere else, or a checkout of only this
# folder. Set it to the directory that contains index.html - absolute, or
# relative to backend/ rather than to wherever you started node.
#
# Left unset and nothing is found, the API still runs and the server says which
# paths it looked at.
#TRYCORD_CLIENT_DIR=
#
# Mounts the client under a prefix as well as the origin root. The document's
# <base href> is rewritten to match at request time, so one build is correct
# either way. Unset serves from the origin root.
#
# Additive, not a move: setting this leaves the origin root serving the client
# exactly as before, so a bookmark on /home or /login keeps working. What it
# fixes is the public site's "Open Trycord" buttons, which point at /app/ on
# every page and were dead links with this unset.
#
# When it is set, /app/backend.json is repointed at this instance too. The
# client fetches ./backend.json relative to its document, so under the mount
# that is the path it asks for - and the repointing is what stops a self-hoster's
# client signing people in against api.trycord.dev.
TRYCORD_APP_MOUNT=/app

# ---- feature flags ------------------------------------------------------
# One switch per meaningful platform capability. Every value is on/off (true/
# false and 1/0 also parse), a blank value falls back to the default shown, and
# anything else is a startup error — a typo must not silently enable or disable
# a capability.
#
# Nothing else in the server reads the environment for a feature decision: the
# routes, the realtime gateway and the client's capability discovery all answer
# from src/features.js, so they cannot disagree.

# New account registration. Off shows the sign-in form only, and an instance
# that is invite-only should set this off and hand out invite links.
REGISTRATION_ENABLED=on

# Whether a new account must confirm its email address before it can post. Only
# enforceable when MAIL_MODE=smtp: with no relay there is no way for anyone to
# confirm an address, and gating on it would lock messaging off permanently.
# Off is therefore the safe default.
EMAIL_VERIFICATION_REQUIRED=off

# File and image uploads, including avatars and community icons.
FILE_UPLOADS_ENABLED=on

# The public discovery feed: communities that chose to be discoverable.
COMMUNITY_DISCOVERY_ENABLED=on

# Bot accounts and their tokens.
BOTS_ENABLED=on

# Incoming webhooks, which let an external service post into a channel.
WEBHOOKS_ENABLED=on

# Browser push notifications, which additionally need a push service and a
# public key. Off until one is configured; in-app notifications work regardless.
PUSH_NOTIFICATIONS_ENABLED=off

# ---- voice and video ----------------------------------------------------
# The master switch. Off by default: this instance has no media server
# configured, and a flag that cannot work is worse than a flag that is off.
#
# With this off, every voice route refuses with FEATURE_DISABLED, the
# capability response says voice is unavailable, and text chat is unaffected.
# With it on but the infrastructure missing, the server refuses to start rather
# than coming up broken.
VOICE_VIDEO_ENABLED=off

# Which media server to talk to. There is exactly one: Cloudflare Realtime SFU,
# which routes media and DataChannels. Its own documentation is explicit that it
# does not provide signalling or room management — the backend still owns who may
# join and who may speak, and the provider only creates sessions and moves SDP.
#
# A peer-to-peer mode with no server-side routing does not exist. An earlier
# revision of this file documented one, and it was never implemented.
VOICE_VIDEO_PROVIDER=cloudflare

# From the Cloudflare Realtime SFU dashboard. The App Secret stays on the
# server and never reaches a client; the App ID is what the API path carries.
# Both are required when VOICE_VIDEO_PROVIDER=cloudflare.
#VOICE_VIDEO_SFU_APP_ID=
#VOICE_VIDEO_SFU_APP_SECRET=

# ICE servers a client uses to open a connection. At least one STUN or a TURN
# URL is required when voice is on, or the server refuses to start.
# Comma-separated for more than one.
#VOICE_VIDEO_STUN_URLS=stun:stun.cloudflare.com:3478

# TURN, for clients behind a symmetric NAT or a firewall that blocks UDP. The
# URL and the static username are given to clients; the credential is minted
# per session by the backend and never appears in the capability response.
#VOICE_VIDEO_TURN_URL=
#VOICE_VIDEO_TURN_USERNAME=
#VOICE_VIDEO_TURN_CREDENTIAL=

# The most participants one channel will hold, enforced server-side before a
# session is created. 1–200.
VOICE_VIDEO_MAX_PARTICIPANTS=25

# Screen sharing and stage channels are separately switchable, but neither can
# be on while the master switch is off: a sub-flag does not conjure
# infrastructure the master says does not exist.
VOICE_VIDEO_SCREEN_SHARING=on
VOICE_VIDEO_STAGE_CHANNELS=on

# ---- status monitor -----------------------------------------------------
# A separate, optional process that checks this instance on a schedule and
# serves the result on its own port. It is deliberately not part of this
# server: a monitor that dies with the service it watches cannot tell you the
# service died. Start it with `npm run status-monitor` (it reads this same
# .env). See docs/status-monitor.md for the full reference.
#
# The target list defaults to this instance's own health routes: / (the public
# site), /health (the API process) and /api/health (the database). Every value
# is configurable, by environment or by a JSON file whose path is
# STATUS_MONITOR_CONFIG. The environment wins over the file, and the file is
# the tidier place for the target list.

# Where the monitor listens. The default is loopback, because this process serves
# reports without authentication - a public status page puts it behind the reverse
# proxy, and set STATUS_MONITOR_HOST there (or to 0.0.0.0) to expose it directly.
#STATUS_MONITOR_HOST=127.0.0.1
#STATUS_MONITOR_PORT=9972

# How often to run the checks, and how long a single check may take.
#STATUS_MONITOR_INTERVAL_MS=30000
#STATUS_MONITOR_TIMEOUT_MS=5000

# Consecutive failures before a component is called down (a single failure below
# this is reported as degraded), and consecutive successes needed to call a
# component recovered. A check slower than SLOW_MS is degraded even if it
# passed. History is how many recent samples per target are kept in memory.
#STATUS_MONITOR_FAILURE_THRESHOLD=2
#STATUS_MONITOR_RECOVERY_THRESHOLD=1
#STATUS_MONITOR_SLOW_MS=1500
#STATUS_MONITOR_HISTORY=180

# The base the target URLs resolve against. Defaults to this instance on
# loopback: http://127.0.0.1:${PORT}.
#STATUS_MONITOR_BASE_URL=

# Dashboard title, instance label, and how often the HTML dashboard reloads
# (0 disables the refresh).
#STATUS_MONITOR_TITLE=Trycord status
#STATUS_MONITOR_INSTANCE=local
#STATUS_MONITOR_REFRESH_SECONDS=15

# Origins allowed to read /status.json from a browser. "*" is the default
# because the report is public, read-only information. Pin it to a comma list
# to restrict who may read it cross-origin.
#STATUS_MONITOR_CORS_ORIGINS=*

# Throwaway settings the monitor also accepts:
#   STATUS_MONITOR_TARGETS   the target list inline, as a JSON array (wins over
#                            the file and the defaults)
#   STATUS_MONITOR_INSTANCE  label shown in the report (default TRYCORD_INSTANCE_ID)
#
# Relative target URLs resolve against STATUS_MONITOR_BASE_URL, so one file can
# move between instances that differ only by host.

# The public URL at which the monitor can be reached from a browser. The
# server reads this one itself: when set, it stamps it into the status page as
# <meta name="status-monitor">, and public/js/status.js reads the monitor's live
# report instead of probing from the browser. Leave it unset and the page keeps
# probing from the browser. A relative value (a monitor reverse-proxied under
# this same origin, e.g. /status-api) is kept relative and needs no CORS.
#STATUS_MONITOR_PUBLIC_URL=
